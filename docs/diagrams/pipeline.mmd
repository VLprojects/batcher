flowchart LR
    P["Producer<br/>consumer, handler, job"]

    subgraph BATCHER["One batcher"]
        direction LR
        B["RecordBuffer<br/>cut by size or age"]
        Q["Queue<br/>bounded"]
        W["Writer thread"]
    end

    CH[("Storage")]
    R["persist record<br/>one by one"]
    F["WriteFallback<br/>queue, file, log"]

    P -->|"accept(record)"| B
    B -->|"Batch"| Q
    Q --> W
    W -->|"persist(batch)"| CH
    W -.->|"batch failed"| R
    R -.-> CH
    R -.->|"record failed"| F
